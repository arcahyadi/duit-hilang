# Salin ke .env lalu isi
DB_PASSWORD=ganti-password-db
SECRET_KEY=ganti-secret-panjang-acak
DOMAIN=finansial.example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-password-admin
# Untuk stack Portainer (RP_ID/RP_ORIGIN dipakai WebAuthn + CSRF):
RP_ID=finansial.example.com
RP_ORIGIN=https://finansial.example.com
COOKIE_SECURE=true
